{
  "name": "fletchery",
  "version": "0.1.0",
  "description": "A local web app for building a Story Bible as Markdown files.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fletchery": "bin/fletchery.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "prepare": "node sentinel-gate/check.js --install",
    "sentinel:install": "node sentinel-gate/check.js --install",
    "sentinel:full": "node sentinel-gate/check.js --full",
    "sentinel:report": "node sentinel-gate/check.js --report",
    "sentinel:spec-reviewed": "node sentinel-gate/check.js --spec-reviewed"
  }
